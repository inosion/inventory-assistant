# Copy to .env (chmod 600) and fill in every CHANGE_ME.
COMPOSE_PROJECT_NAME=inventree

# ---- Site ----
# Hostname devices use to reach the server, and the published HTTPS port.
SITE_HOST=inventory.example.lan
HTTPS_PORT=8443

# ---- InvenTree ----
INVENTREE_TAG=1.7.1
INVENTREE_SITE_URL=https://inventory.example.lan:8443
INVENTREE_TRUSTED_ORIGINS=https://inventory.example.lan:8443
INVENTREE_ALLOWED_HOSTS=*
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True
# Phones get the full web UI instead of the "Mobile viewport detected" page
INVENTREE_FRONTEND_SETTINGS={"mobile_mode":"allow-always"}
INVENTREE_TIMEZONE=UTC

INVENTREE_LOG_LEVEL=WARNING
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_AUTO_UPDATE=True
INVENTREE_GUNICORN_TIMEOUT=90

INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=inventree
INVENTREE_DB_PASSWORD=CHANGE_ME

INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

# First-boot superuser (only created if it does not exist)
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_EMAIL=admin@example.com
INVENTREE_ADMIN_PASSWORD=CHANGE_ME

# ---- inventory-assistant ----
# API token of an InvenTree user allowed to create parts, stock and locations
# (InvenTree: user menu > Account settings > Access tokens).
ASSISTANT_INVENTREE_TOKEN=CHANGE_ME
ASSISTANT_TAG=latest
# Ollama with a vision model. Default: Ollama on the Docker host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# markings (research every item with part numbers) | low (only low-confidence) | off
RESEARCH_POLICY=markings
# Merge a capture of a part already in InvenTree into that part (photo attached, stock added): on | off
DEDUP=on

# ---- SearXNG ----
# Any long random string, e.g. `openssl rand -hex 32`
SEARXNG_SECRET=CHANGE_ME
